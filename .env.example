# SYCONIA environment template — copy to .env.local and fill (SOP.md §1, ARCHITECTURE.md §12)
# All secrets >= 32 random chars. Boot validator fails closed on missing/weak values.
DATABASE_URL=postgresql://user:pass@host:5432/syconia
DATABASE_POOL_URL=postgresql://user:pass@pool-host:6543/syconia
AGE_SECRET=replace-with-32-plus-random-chars
CURSOR_SECRET=replace-with-32-plus-random-chars
SESSION_SECRET=replace-with-32-plus-random-chars
CRON_SECRET=replace-with-32-plus-random-chars
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=argon2id-hash-generated-via-npm-run-hash-password
SITE_URL=https://example.com
SITE_NAME=SYCONIA
LOG_LEVEL=info
# Per approved source keys (only for sources requiring them):
# SOURCE_EXAMPLESLUG_KEY=
AGE_LEAVE_URL=https://www.wikipedia.org   # neutral leave-site target for the age gate (SCREENS S-01)
